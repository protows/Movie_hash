package lesson_4.hashproject1;
import java.util.Objects;
public class Movie {
    String title; // название фильма
    int releaseYear; // год выхода на экраны

    public Movie(String title, int releaseYear) {
        this.title = title;
        this.releaseYear = releaseYear;
    }

    public String description() { // метод для вывода описания фильма
        return '"' + title + "\" (" + releaseYear + " год)";
    }
    
     @Override
    public boolean equals(Object o){
        if(this==o){return true;}
        if(o==null){return false;}
        if(this.getClass() != o.getClass()){return false;}
        Movie person = (Movie)o;
        return Objects.equals(title, person.title) && Objects.equals(releaseYear, person.releaseYear);
    }
    
    @Override 
    public int hashCode() { 
    int hash = 17; 
    if (title != null) { 
    hash = hash + title.hashCode(); 
    }  
    hash = (hash * 31) + releaseYear;
    return hash; 
    }
}
